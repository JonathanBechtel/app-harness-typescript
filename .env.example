# Copy to .env for local development. Never commit .env. scripts/bootstrap-env.ts
# writes a sandbox-safe .env for you; this file documents every variable the app
# reads (app/config.ts is the single source of truth — keep the two in sync;
# tests/unit/settings-documented.test.ts enforces it).

# --- Core ---------------------------------------------------------------
# dev | stage | prod. Anything but prod raises on guard violations (see
# app/utils/network-guard.ts); prod logs and continues.
APP_ENV=dev
DEBUG=1
LOG_LEVEL=info
# JSON logs are on outside dev. Set LOG_JSON=1 locally to see what prod emits.
LOG_JSON=
# Used to sign sessions/tokens. bootstrap generates a random one.
SECRET_KEY=change-me
# Where the server binds. Platforms that inject PORT (Azure Container Apps,
# Databricks Apps via DATABRICKS_APP_PORT) override it at deploy time.
HOST=0.0.0.0
PORT=8000

# --- Database -----------------------------------------------------------
# postgresql://user:pass@host:port/db
DATABASE_URL=postgresql://postgres:postgres@localhost:5439/app
# Connections per process. Ceiling on Postgres connections is DB_POOL_SIZE * replicas.
DB_POOL_SIZE=10
# A request that cannot get a connection fails after this many seconds instead
# of holding the event loop: saturation should look like an error, not a stall.
DB_POOL_TIMEOUT=10

# --- Tests --------------------------------------------------------------
# Integration tests need an explicit opt-in AND a disposable database that is
# not DATABASE_URL (tests/integration/gate.ts refuses otherwise).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5439/app_test
TEST_ALLOW_DB=1
# On a box that HAS a database, a missing URL must fail rather than skip the
# whole suite into a green-looking exit 0.
TEST_REQUIRE_DB=1

# --- LLM providers (optional; only if the app has AI features) -----------
# Roles map to (provider, model) pairs so the app never hardcodes a model id.
# See app/ai/registry.ts and docs/guides/llm-features.md.
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-opus-5
# Per-role overrides, e.g. AI_SUMMARIZER_PROVIDER / AI_SUMMARIZER_MODEL.

# --- Deployment identity (set by the build, not by hand) -----------------
# RELEASE_SHA is injected by the Dockerfile from --build-arg GIT_SHA and reported
# by /health so scripts/check-deploy-freshness.ts can measure drift from main.
