# Environments and secrets — never commit. `.env*` with an explicit allowlist so a
# new variant (.env.qa.local, .env.bak) is ignored by default.
.env*
!.env.example
.envrc
.claude/settings.local.json
.claude/worktrees/
.codex/worktrees/
.codex/environments/

# Node
node_modules/
dist/
*.tsbuildinfo

