{
  // Type-checks EVERYTHING (app, scripts, tests, evals, tasks.ts): CI runs `tsc --noEmit`
  // over this file. The shipped build uses tsconfig.build.json (app/ only).
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["app", "scripts", "tests", "evals", "tasks.ts", "*.config.ts", ".claude/hooks"],
  "exclude": ["node_modules", "dist", "app/static"]
}
